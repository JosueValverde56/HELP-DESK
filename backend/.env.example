# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Oracle Database ──────────────────────────────────────────────────────────
DB_USER=helpdesk
DB_PASSWORD=your_db_password
DB_CONNECTION_STRING=localhost:1521/XE

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera una clave fuerte: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_with_a_random_64_byte_hex_string

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Nodemailer — Gmail recomendado) ────────────────────────────────────
# En Gmail: activar 2FA → Contraseñas de aplicación → genera una de 16 dígitos
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx    # App Password de Google (sin espacios)
EMAIL_FROM=Helpdesk <tu_correo@gmail.com>

# ─── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# 1. Crea cuenta en https://www.twilio.com (gratis)
# 2. Ve a Messaging → Try it out → Send a WhatsApp message (sandbox)
# 3. Copia Account SID y Auth Token desde el Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox: whatsapp:+14155238886  |  Producción: whatsapp:+TU_NUMERO
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
